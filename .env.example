# Razorpay Payment Gateway (Test Mode)
RAZORPAY_KEY_ID=rzp_test_TrOIX04mK2CPUD
RAZORPAY_KEY_SECRET=your_razorpay_secret
PORT=5000

# Email Delivery Configuration (Nodemailer / SMTP)
# Leave empty for safe simulated delivery mode during testing
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=support@aquapure.com
SMTP_PASS=your_app_password
SMTP_FROM="AquaPure Support" <support@aquapure.com>

# SMS Delivery Configuration (TextBee Gateway API - https://textbee.dev)
# Set SMS_ENABLED=true and provide credentials for live carrier SMS
TEXTBEE_API_KEY=your_textbee_api_key
TEXTBEE_DEVICE_ID=your_textbee_device_id
SMS_ENABLED=false

# Firebase Admin Service Account (JSON string for Render private environment variable)
FIREBASE_SERVICE_ACCOUNT_JSON=
